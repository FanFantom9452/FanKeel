+```
+
+### Step 4: 讀行號、報 `past end`
+
+In `scripts/todo-check.js`, after `const { blameTimes } = require('../lib/blame.js');`, add:
+
+```js
+const { CODE, PATHISH, lineCount } = require('./docs-check.js');
+```
+
+In `scripts/todo-check.js`, directly after the `linksIn` function, add:
+
+```js
+// A link target may end in `:N` or `:N-M`. Left on, the whole string was taken
+// as the file name and reported as a dead link — the file was there, the reason
+// was wrong. Split off, the file is checked as a file and the number as a line.
+const LINE_SUFFIX = /:(\d+)(?:[-–](\d+))?$/;
+function splitLine(target) {
+    const m = LINE_SUFFIX.exec(target);
+    if (!m) return { target, from: null, to: null };
+    return { target: target.slice(0, m.index), from: parseInt(m[1], 10), to: m[2] ? parseInt(m[2], 10) : null };
+}
+
+// Every backticked span shaped like a path with a line number — the same shape
+// docs-check reads. A span naming a file that is not here is docs-check's
+// `gone`, not this; only the line number is asked about here.
+function citationsIn(text) {
+    const out = [];
+    const code = new RegExp(CODE.source, 'g');
+    let m;
+    while ((m = code.exec(text)) !== null) {
+        const hit = PATHISH.exec(m[1].trim());
+        if (!hit || !hit[2]) continue;
+        out.push({ target: hit[1], from: parseInt(hit[2], 10), to: hit[3] ? parseInt(hit[3], 10) : null });
+    }
+    return out;
+}
+```
+
+In `scripts/todo-check.js`, in `check()`, directly after `const found = entries(text);`, add:
+
+```js
+    // A line number past the end of its file is a citation that stopped being
+    // true: the code moved and the entry did not.
+    const pastEnd = (entry, target, full, from, to) => {
+        if (from === null) return;
+        const n = lineCount(base, path.relative(base, full));
+        const label = target + ':' + from + (to !== null ? '-' + to : '');
+        let why = null;
+        if (to !== null && from > to) why = ' — the range starts after it ends';
+        else if (n !== null && (to !== null ? to : from) > n) why = ' but the file ends at ' + n;
+        if (why) {
+            problems.push({
+                line: entry.line,
+                kind: 'past end',
+                detail: label + why + '. The code moved and the entry did not — point it at the line it means.',
+            });
+        }
+    };
+```
+
+In `scripts/todo-check.js`, in `check()`, replace the start of the link loop:
+
+```js
+        for (const target of linksIn(entry.text)) {
+            const full = path.resolve(base, target);
+```
+
+with, in `scripts/todo-check.js`:
+
+```js
+        for (const link of linksIn(entry.text)) {
+            const { target, from, to } = splitLine(link);
+            const full = path.resolve(base, target);
+```
+
+In `scripts/todo-check.js`, in the same loop, directly before `const role = docs.roleOf(tree, path.relative(base, full));`, add:
+
+```js
+            pastEnd(entry, target, full, from, to);
+```
+
+In `scripts/todo-check.js`, directly after the closing `}` of that link loop (still inside `for (const entry of found)`), add:
+
+```js
+        for (const c of citationsIn(entry.text)) {
+            const full = path.resolve(base, c.target);
+            if (!fs.existsSync(full)) continue;
+            pastEnd(entry, c.target, full, c.from, c.to);
+        }
+```
+
+
+### Step 5: TODO.md
+
+In `TODO.md`, delete the whole `## Ready` bullet that begins `- 〔docs〕todo-check 不驗 \`path:line\` 的行號`（目前在 `TODO.md:78`，一行）。
+
+In `TODO.md`, replace `` `node scripts/todo-check.js` enforces all nine: a link that no longer resolves is `` with `` `node scripts/todo-check.js` enforces all ten: a link that no longer resolves is ``, and replace `for nothing, and a title over 28 columns is a sentence where a name belongs.` with:
