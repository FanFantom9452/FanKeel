+
+test('a link to path:line past the end is past end, not a dead link', () => {
+  const file = fixture('# TODO\n\n## Ready\n\n- Fix — see [a](lib/a.js:99).\n', THREE);
+  assert.deepEqual(kinds(file), ['past end']);
+});
+
+test('a line or a range inside the file passes', () => {
+  const file = fixture('# TODO\n\n## Ready\n\n- Fix — `lib/a.js:2` and [a](lib/a.js:2-3).\n', THREE);
+  const { code } = run(file);
+  assert.equal(code, 0);
+});
+
+test('a range that runs past the end is past end', () => {
+  const file = fixture('# TODO\n\n## Ready\n\n- Fix — see `lib/a.js:2-9`.\n', THREE);
+  assert.deepEqual(kinds(file), ['past end']);
