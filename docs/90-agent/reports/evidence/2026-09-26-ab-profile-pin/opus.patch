+- [ ] **Step 5: `linksIn` 拆行號，新增 `citationsIn`。** In `scripts/todo-check.js`, replace the whole `function linksIn(text) { ... }` with:
+
+```js
+function linksIn(text) {
+    const out = [];
+    LINK.lastIndex = 0;
+    let m;
+    while ((m = LINK.exec(text)) !== null) {
+        const target = m[1].trim().split(/\s+/)[0].replace(/^<|>$/g, '');
+        if (!target || EXTERNAL.test(target)) continue;
+        // `path:N` names a file and a line in it. The file is what has to
+        // exist; the line is `citationsIn`'s to check.
+        const cited = docsCheck.PATHISH.exec(target);
+        out.push(cited && cited[2] ? cited[1] : target.split('#')[0]);
+    }
+    return out;
+}
+
+// Every `path:N` and `path:N-M` an entry cites, from a link target or a code
+// span, parsed with docs-check's own `PATHISH`. A path with no line is not
+// returned: there is no line to count against.
+function citationsIn(text) {
+    const out = [];
+    const take = (s) => {
+        const m = docsCheck.PATHISH.exec(s);
+        if (!m || !m[2]) return;
+        out.push({ target: m[1], from: Number(m[2]), to: Number(m[3] || m[2]), lines: s.slice(s.lastIndexOf(':') + 1) });
+    };
+    for (const m of text.matchAll(LINK)) take(m[1].trim().split(/\s+/)[0].replace(/^<|>$/g, ''));
+    for (const m of text.matchAll(docsCheck.CODE)) take(m[1].trim());
+    return out;
+}
+```
+
+- [ ] **Step 6: 在 `check()` 報 `past end`。** In `scripts/todo-check.js`, in `check()`, directly after the closing `}` of the `for (const target of linksIn(entry.text)) { ... }` loop and still inside `for (const entry of found)`, add:
+
+```js
+        // A line past the end is reported whatever role the file has: the
+        // role says whether to point there at all, this says the code the
+        // entry means is no longer where it says. A file that does not exist
+        // is `dead link`'s, or for a code span nobody's, so it is skipped here.
+        for (const c of citationsIn(entry.text)) {
+            const n = docsCheck.lineCount(base, c.target);
+            if (n === null || c.to <= n) continue;
+            problems.push({
